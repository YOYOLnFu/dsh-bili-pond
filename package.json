{
  "name": "dsh-bili-pond",
  "version": "1.3.14",
  "description": "蓝色大肥鱼替你看 B 站、写日报、记偏好和写日记；评论区支持守护与只接邀请的圈地自萌；点赞和收藏默认关闭且必须带理由。自动运行和自动评论默认关闭。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "bili",
    "radar",
    "daily-digest"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOYOLnFu/dsh-bili-pond.git"
  },
  "homepage": "https://github.com/YOYOLnFu/dsh-bili-pond#readme",
  "bugs": {
    "url": "https://github.com/YOYOLnFu/dsh-bili-pond/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "assets",
    "prompts",
    "vendor",
    "tools",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md",
    "selfcheck.mjs"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "check": "node --import ./tools/register.mjs selfcheck.mjs && node tools/_check-1016.mjs && node tools/test-migrate.mjs && node tools/test-comment-cap.mjs && node tools/test-reuse-routes.mjs && node tools/test-host-default-model.mjs && node tools/test-guard.mjs && node tools/test-guard-watermark.mjs && node tools/test-duty-workspace.mjs && node tools/test-history.mjs && node tools/test-pond-page.mjs && node tools/test-circle-config.mjs && node tools/test-intent-lines.mjs && node tools/test-likes.mjs && python tools/test-circle.py",
    "prepublishOnly": "npm run check"
  },
  "author": {
    "name": "YOYOLnFu",
    "url": "https://space.bilibili.com/14430149"
  }
}
